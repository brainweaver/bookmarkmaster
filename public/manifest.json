{
  "manifest_version": 3,
  "name": "BookmarkMaster",
  "description": "Save and organize bookmarks with tags, search, and multiple views",
  "version": "1.0.1",
  "permissions": [
    "tabs",
    "activeTab",
    "contextMenus",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BookmarkMaster",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
